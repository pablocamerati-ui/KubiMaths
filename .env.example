# Opcional: copiar como .env.local para apuntar a otro proyecto de Supabase
# (por defecto la app usa kubi-dev, configurado en app.json). No subir .env.local al repositorio.
# La clave publicable puede ir en la app: la seguridad la dan las políticas por fila de Supabase.
# Sin estas variables, KUBI guarda el progreso solo en el teléfono.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
