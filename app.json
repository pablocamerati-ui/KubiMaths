{
  "expo": {
    "name": "KUBI",
    "slug": "kubi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cl.kubi.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "cl.kubi.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "scheme": "kubi",
    "backgroundColor": "#F7F8FF",
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FF"
    },
    "extra": {
      "supabase": {
        "url": "https://zmtjylyqgtkbsrzpsmio.supabase.co",
        "publishableKey": "sb_publishable_GMA7urG5JAc207nYr9aidg_AjsN1p3D"
      }
    }
  }
}
